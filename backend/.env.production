# Production Environment Variables Template
# Copy this file to .env and fill in your actual values

# Environment
NODE_ENV=production

# Server
PORT=5001

# Database - Use MongoDB Atlas for production
MONGODB_URI=your-mongodb-atlas-connection-string

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-2024-very-long-and-secure
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-production-email@gmail.com
SMTP_PASSWORD=your-production-app-password

# Frontend URL - Update with your deployed frontend URL
CLIENT_URL=https://your-app-name.vercel.app
FRONTEND_URL=https://your-app-name.vercel.app

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Stripe (if using payments)
STRIPE_SECRET_KEY=sk_live_your-live-stripe-key